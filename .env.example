# ============================================================================
# ProspecIA — copie para .env e preencha. NUNCA versione o .env.
# Todas as chaves ficam apenas no backend; o navegador nunca as recebe.
# ============================================================================

# --- Aplicação ---
APP_ENV=development                 # development | production
SECRET_KEY=troque-por-uma-chave-aleatoria-de-64-caracteres   # python -c "import secrets;print(secrets.token_hex(32))"
ACCESS_TOKEN_MINUTES=720
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false                 # true em produção (HTTPS)
ALLOW_REGISTRATION=true             # false em produção: apenas admins criam usuários
SINGLE_USER_MODE=true               # uso individual: só a primeira conta pode ser criada
LOG_LEVEL=INFO

# --- Infra (o docker-compose já define estes dois) ---
DATABASE_URL=postgresql+psycopg://prospec:prospec@localhost:5432/prospecia
REDIS_URL=redis://localhost:6379/0
RUN_WORKER_IN_API=false             # true = processa a fila dentro da API (só para dev local sem worker)
WORKER_CONCURRENCY=4

# --- Nuvem sem servidor (Vercel + Neon) — veja docs/DEPLOY_VERCEL.md ---
PROCESSING_MODE=worker              # worker (Docker/VPS) | request (Vercel: o navegador/cron dispara a fila)
TICK_BUDGET_SECONDS=40
CRON_SECRET=                        # protege /api/worker/cron
AUTO_MIGRATE=false                  # true na Vercel: cria/atualiza as tabelas na 1ª requisição
DB_NULL_POOL=false                  # true na Vercel
JOB_STALE_MINUTES=10                # 2 na Vercel
# DATABASE_URL_UNPOOLED=            # criada automaticamente pela integração Neon

# --- Modo somente gratuito (recomendado para uso individual) ---
# O sistema conta cada requisição e PARA antes de sair da cota grátis: você não é cobrado.
# Veja docs/PAGAMENTO.md para cadastrar boleto/cartão e as cotas de cada provedor.
FREE_TIER_ONLY=true
FREE_TIER_SAFETY_PERCENT=90         # usa no máximo 90% da cota grátis
GOOGLE_PLACES_FREE_MONTHLY_REQUESTS=1000   # cota grátis do SKU Text Search Enterprise (confira no console)
BRAVE_SEARCH_FREE_MONTHLY_REQUESTS=1000    # US$ 5 de crédito mensal ÷ US$ 0,005 por consulta
GOOGLE_CSE_FREE_DAILY_REQUESTS=100
WEB_QUERIES_PER_BUSINESS=1          # 1 = só nome+cidade (dobra o rendimento da cota); 2 = também telefone

# --- Fonte 1: Google Places API (New) — requer faturamento ativo no Google Cloud ---
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_RPS=5
GOOGLE_PLACES_CACHE_HOURS=0         # termos da Google Maps Platform restringem cache
GOOGLE_PLACES_RETENTION_DAYS=30
COST_GOOGLE_TEXT_SEARCH_PER_REQUEST=0.035

# --- Fonte 2: OpenStreetMap (gratuito, sem chave) ---
OSM_ENABLED=true
OSM_CONTACT_EMAIL=seu-email@empresa.com.br   # exigido pela política do Nominatim (User-Agent identificável)
OVERPASS_URL=https://overpass-api.de/api/interpreter
NOMINATIM_URL=https://nominatim.openstreetmap.org
OSM_RPS=0.5

# --- Busca web autorizada para verificar sites (configure ao menos uma) ---
BRAVE_SEARCH_API_KEY=               # recomendado: https://api-dashboard.search.brave.com
COST_BRAVE_SEARCH_PER_REQUEST=0.005
GOOGLE_CSE_API_KEY=                 # legado: fechado a novos clientes, encerra em 01/01/2027
GOOGLE_CSE_CX=
WEB_SEARCH_CACHE_HOURS=24

# --- Verificação de sites ---
ENABLE_DOMAIN_GUESSING=true
VERIFICATION_TTL_DAYS=30
SITE_CHECK_TIMEOUT_SECONDS=10

# --- IA (opcional) ---
AI_PROVIDER=none                    # none | anthropic
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_EFFORT=low
AI_INPUT_PRICE_PER_MTOK=4.0
AI_OUTPUT_PRICE_PER_MTOK=20.0

# --- Limites padrão por usuário ---
DEFAULT_MONTHLY_BUDGET_USD=25
DEFAULT_MAX_RESULTS_PER_SEARCH=200
HARD_MAX_RESULTS_PER_SEARCH=2000
